	set dlg [winfo toplevel $saveBtn]

	if {[$saveBtn cget -state] == "normal"} {
		set reply [::dialog::question -message $::application::mc::ThrowAwayAllChanges -parent $dlg]
		if {$reply eq "no"} { return }
