	}
	set map(\n) %0D%0A
	variable formMap [array get map]

	variable socketmap
	if {[info exists socketmap]} {
	    foreach {url sock} [array get socketmap] {
		catch {close $sock}
	    }
	}
	array set socketmap {}
    }
    init

    variable urlTypes
