proc fill {path first {last -1}} {
	set table $path.top.table
	variable ${table}::

	if {$last == -1} { set last $first }
	set start $(start)
	TableFill $table [list [expr {$first - $start}] [expr {$last - $start}]] false
}


proc selection {path} {
	set table $path.top.table
	variable ${table}::

	if {[llength $(selection)] == 0} { return -1 }
	return [expr {$(selection) - $(start)}]
}


proc active {path} {
