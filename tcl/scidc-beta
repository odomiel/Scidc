proc hilite {w i which} {
	variable [namespace parent]::hilite
	variable ${w}::Board

	if {$i < 0 || $i > 63} { return }

	if {$which eq "off"} {
		$w.c itemconfigure selected:$i -state hidden
		$w.c itemconfigure suggested:$i -state hidden
	} else {
		$w.c itemconfigure $which:$i -state normal
		$w.c raise $which:$i
		$w.c raise suggested:$i
		raisePiece $w
		RaiseInput $w
	}
}


