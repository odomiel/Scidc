	variable ${tree}::Vars

	set msg $mc::StartOfMotorFailed
	append msg ": "
	if {![string is integer -strict $rc]} {
		append msg "\"" $rc "\""
	} else {
		append msg $mc::WineIsNotInstalled
	}
	append msg "."
	set Vars(current:message) [list [namespace current]::DisplayStartOfMotorFailed $tree $rc]
