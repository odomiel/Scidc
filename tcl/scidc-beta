proc Format {value} {
	return [expr {$value/10}][::locale::decimalPoint][expr {$value%10}]
}


proc SetItemState {table index} {
	variable Options
	variable Vars

	if {$Vars(nextmove) != $index || !$Options(hilite:nextmove)} { append states ! }
	append states next
