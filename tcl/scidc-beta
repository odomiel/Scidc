	if {[trialMode? $pos]} {
		::scidc::game::pop $pos
		::gamebar::setEmphasized [::application::pgn::gamebar] 0
	} else {
		::scidc::game::push $pos
		::gamebar::setEmphasized [::application::pgn::gamebar] 1
	}
}


proc trialMode? {{pos -1}} {
