	set Board(marks) {}
	set Board(alternatives) {}
	set Board(size) $size
	set Board(data) ""
	set Board(promoted) ""
	set Board(drag:square) -1
	set Board(drag:active) 0
	set Board(drag:x) -1
	set Board(drag:y) -1
	set Board(pointer:x) -1
	set Board(pointer:y) -1
	set Board(animate) 1
