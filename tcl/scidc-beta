	pack $twm -fill both -expand yes

	if {$id eq "board"} {
		bind $twm <<TwmGeometry>> [namespace code [list geometry %d]]
		bind $twm <<TwmFullscreen>> [namespace code [list Fullscreen $twm %d]]
		bind $twm <<Fullscreen>> [namespace code geometry]
