proc computeHeight {path rows} {
	set table $path.top.table
	variable ${table}::
	variable Defaults

	set parent ${path}.top
	set sc ${parent}.scale
	set height [::table::computeHeight $parent.table $rows]
	if {$sc in [grid slaves $parent]} {
		incr height [winfo reqheight $sc]
		incr height [expr {2*$Defaults(scale:pady)}]
	}
	return $height
}


