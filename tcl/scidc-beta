proc DeleteFile {parent path} {
	variable FileEncodings

	set result {}
	set file [file rootname $path]
	::application::database::removeRecentFile $path
	foreach ext [::scidc::misc::suffixes $path] {
		lappend result "$file.$ext"
	}
	return $result
