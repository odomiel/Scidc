proc dbNew {parent variant} {
	variable FileSelBoxInUse

	if {$FileSelBoxInUse} { return 0 }
	set FileSelBoxInUse 1

	set filetypes {}
	if {$variant eq "Normal"} {
		lappend filetypes [list $mc::ScidBases {.si5}]
	}
	lappend filetypes [list $mc::ScidbBases {.sci}]
	if {$variant in {Normal Undetermined}} {
		lappend filetypes [list $mc::PGNFilesArchives {.pgn .pgn.gz}]
	}
	set defaultExtension [expr {$variant eq "Normal" ? ".si5" : ".sci"}]
	set result [::dialog::saveFile \
		-parent $parent \
		-class database \
		-filetypes $filetypes \
		-geometry last \
		-defaultextension $defaultExtension \
		-defaultencoding utf-8 \
		-needencoding 1 \
		-title "[set [namespace current]::mc::NewFile] ($::mc::VariantName($variant))" \
		-customicon $::icon::16x16::filetypeArchive \
		-customtooltip $mc::Archiving \
		-customcommand [namespace code [list CreateArchive]] \
		-customfiletypes {.sci .pgn .pgn.gz .bpgn .bpgn.gz} \
	]
	set FileSelBoxInUse 0

	if {[llength $result] == 0} { return 0 }
	lassign $result base encoding
	set ext [file extension $base]
	if {$ext in {.pgn .gz}} { set variant Undetermined }
	return [::application::database::newBase $parent $variant $base $encoding]
}


