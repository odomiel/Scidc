proc GetNormalizedComment {} {
	variable Vars

	set comment [GetComment]

	set content [::scidc::misc::xml toList $comment \
		-expandemoticons [ExpandEmoticons] \
		-detectemoticons [DetectEmoticons] \
		-replacespaces "\u2423" \
