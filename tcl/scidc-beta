	if {$index >= 0 && $index <= [::scidc::game::count variations]} {
		if {$index > 0} { ::scidc::game::go variation [expr {$index - 1}] }
		::scidc::game::go +1
		if {$Options(show:annotation)} { ShowAnnotation }
	}
}


