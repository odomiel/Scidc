	### text pane ###########################################################
	set edit [ttk::frame $main.edit]
	tk::text $edit.txt \
		-width $width \
		-height 10 \
		-background white \
		-foreground black \
		-selectbackground [::colors::lookup engine,selectbackground:setup] \
		-selectforeground [::colors::lookup engine,selectforeground:setup] \
		-borderwidth 1 \
		-relief sunken \
