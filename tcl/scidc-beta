proc getPgnFlags {} {
	variable Flags
	variable Values

	set flags 0
	foreach attr [array names Flags] {
		if {$Values(pgn,flag,[lindex [split $attr ,] 1])} {
			set flags [expr {$flags | [Pow2 $Flags($attr)]}]
		}
	}
	return $flags
}


