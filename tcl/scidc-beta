proc RecordGeometry {pw} {
	variable Options
	variable Priv

	set dlg [winfo toplevel $pw]

	lassign {0 0} x y
	scan $Options(geometry) "%dx%d%d%d" _ _ x y
	scan [wm geometry $dlg] "%dx%d%d%d" w h x y
	if {$x < 0} { set x 0 }
	if {$y < 0} { set y 0 }

	if {$Priv(extend)} {
		set w [expr {$w + $Options(treewidth)}]
	}

	set Options(geometry) "${w}x${h}+${x}+${y}"
}


