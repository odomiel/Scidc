##### Makefile.in for Scidc for Unix operating systems.

# Compiler:
#-----------------------------------------------------------------------
CC                = gcc
CXX               = g++
CFLAGS            = -Wall
CXXFLAGS          = -Wall
SYS_CFLAGS        = -fcommon
SYS_CXXFLAGS      = -fcommon
C_DEBUG           = -g
CXX_DEBUG         = -g
OPTIMIZE          = 
PROFILING         = 

# Compiler constants:
#-----------------------------------------------------------------------
SIMD              = 
THR_SUPPORT       = 
HAVE_XFT          = -DHAVE_XFT
HAVE_FREETYPE     = -DHAVE_FREETYPE
HAVE_LIBFAM       = 
HAVE_INOTIFY      = -DHAVE_INOTIFY=1
SYS_INOTIFY       = 
HAVE_STATVFS      = 
USE_POPCNT        = 
USE_INLINE_TEXT   = -DUSE_INLINE_TEXT=1

#
# Compiler warnings:
#-----------------------------------------------------------------------
NO_UNUSED_RESULT  = -Wno-unused-result

# Linker:
#-----------------------------------------------------------------------
AR                = ar
ARFLAGS           = rc
RANLIB            = ranlib
STRIP             = strip
LDFLAGS           = 
SYS_LDFLAGS       = -Wl,--allow-multiple-definition -Wl,-Bsymbolic-functions

# BINDIR: where the Scidc programs are copied for "make install".
#-----------------------------------------------------------------------
BINDIR            = /usr/local/bin
ENGINESDIR        = /usr/local/games
LIBDIR            = /usr/local/lib
SHAREDIR          = /usr/local/share/scidc
MANDIR            = /usr/local/man
FONTDIR           = /usr/local/share/fonts/truetype/Scidc
DATADIR           = /usr/local/share/scidc
XDGDIR            = 

# TCL_VERSION: Set this according to the version of Tcl/Tk you have
# installed that you want Scidc to use: 8.5, 8.6, etc.
#-----------------------------------------------------------------------
TCL_VERSION       = 9.0
TCL_SHELL         = LD_LIBRARY_PATH=/home/thomas/tcl9/lib /home/thomas/tcl9/bin/tclsh

# TCL_INCLUDE, TCL_LIBRARY, TK_LIBRARY: these are the compiler options
# needed for linking Scidc with Tcl/Tk. The program "./configure"
# will try to determine them automatically, but if it cannot, you
# can use the examples below for help in setting these variables.
#-----------------------------------------------------------------------
TCL_INCLUDE       = -I/home/thomas/tcl9/include
TCL_LIBRARY       = -L/home/thomas/tcl9/lib -Wl,-rpath,/home/thomas/tcl9/lib -ltcl9.0
TK_INCLUDE        = -I/home/thomas/tcl9/include
TK_LIBRARY        = -L/home/thomas/tcl9/lib -Wl,-rpath,/home/thomas/tcl9/lib -ltcl9tk9.0
X_INCLUDE         = -I/usr/include
X_LIBRARY         = -L/usr/lib/x86_64-linux-gnu -lX11 -lSM -lICE -L/usr/lib/x86_64-linux-gnu -lXcursor
FREETYPE_INC      = -I/usr/include/freetype2 -I/usr/include/libpng16 

# Options for zlib, zziplib, expat, and fam/inotify.
#-----------------------------------------------------------------------
EXPAT_INC         = 
EXPAT_LIB         = -lexpat
ZLIB_INC          = 
ZLIB_LIB          = -lz
ZZIPLIB_INC       = -I/home/thomas/KI/Claude/scidb/scidb-code-r1531-trunk/src/util/zzip
ZZIPLIB_LIB       = /home/thomas/KI/Claude/scidb/scidb-code-r1531-trunk/src/util/zzip/libzzip.a
FAM_LIB           = 
LIB_SUBDIRS       = util/zzip

# Installation control:
#-----------------------------------------------------------------------
FREEDESKTOP       = yes

# Name of program suffix and engines.
#-----------------------------------------------------------------------
SUFFIX            = -beta
ENGINES           = stockfish fairy-stockfish

# Common targets:
#-----------------------------------------------------------------------
.PHONY : clean
.PRECIOUS:

EXTRA_CFLAGS      = -pipe -Wno-format-security -fcommon -Wno-cpp -fno-stack-protector
EXTRA_CXXFLAGS    = -std=c++14 -DBROKEN_LINKER_HACK=1 -DTWM_MIGRATE_LAYOUT=1 -DDONT_USE_GDB -DDONT_USE_FRAME_ADDR -pipe -Wno-format-security -fcommon -Wno-cpp -fno-stack-protector
EXTRA_DEBUG_FLAGS = 

